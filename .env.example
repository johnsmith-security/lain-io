# Comma-separated Gun relay URLs reachable by mobile devices, e.g. wss://relay.example.com/gun
EXPO_PUBLIC_GUN_PEERS=

# HTTP base of the main relay's services (username registrar, recovery mail, account purge)
EXPO_PUBLIC_LAIN_SERVICE_URL=

# Image/video service if it runs elsewhere than SERVICE_URL (empty: same as SERVICE_URL)
EXPO_PUBLIC_LAIN_MEDIA_URL=

# LainCorp service account public keys (generate with: node relay/tools/keygen.js)
EXPO_PUBLIC_LAIN_REGISTRAR_PUB=
EXPO_PUBLIC_LAIN_MODERATION_PUB=
EXPO_PUBLIC_LAIN_MODERATION_EPUB=

# Single source of truth for moderation: the Cloudflare relay's signed list
# (e.g. https://relay.lain.xn--tckwe/lain/moderation). Values are verified against MODERATION_PUB.
EXPO_PUBLIC_LAIN_MODERATION_URL=

# Archivist account: signs the keep list of top posts that outlive the 30-day retention
EXPO_PUBLIC_LAIN_ARCHIVIST_PUB=
EXPO_PUBLIC_LAIN_RELEASE_PUB=
