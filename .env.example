# Google OAuth client IDs from Google Cloud Console. Use a different client ID per platform.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Comma-separated Gun relay URLs reachable by mobile devices, e.g. wss://relay.example.com/gun
EXPO_PUBLIC_GUN_PEERS=
