{
  "expo": {
    "name": "Lain IO",
    "slug": "lain-io",
    "scheme": "lainio",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      "expo-dev-client",
      [
        "expo-asset",
        {
          "assets": [
            "./lain.glb"
          ]
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Lain IO to access your photos and videos to share them in posts and set your profile picture."
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "react-native-quick-crypto",
      "expo-video"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lainio.app"
    },
    "android": {
      "package": "com.lainio.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#12042E"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "icon": "./assets/images/icon.png"
  }
}
